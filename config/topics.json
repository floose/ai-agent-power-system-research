{
  "lookback_days": 45,
  "rows_per_topic": 50,
  "max_papers": 5,
  "preferred_publishers": [
    "IEEE",
    "Institute of Electrical",
    "Elsevier"
  ],
  "topics": [
    {
      "id": "optimal-power-flow",
      "query": "optimal power flow neural network",
      "patterns": [
        "\\boptimal power flow\\b",
        "\\bsecurity.constrained.*dispatch",
        "\\beconomic dispatch\\b"
      ]
    },
    {
      "id": "load-forecasting",
      "query": "load forecasting deep learning",
      "patterns": [
        "\\bload forecast",
        "\\belectricity demand forecast",
        "\\belectric(?:al)? demand predict"
      ]
    },
    {
      "id": "dynamic-line-rating",
      "query": "dynamic line rating machine learning",
      "patterns": [
        "\\bdynamic line rating",
        "\\bdynamic thermal rating",
        "\\bline ampacity"
      ]
    },
    {
      "id": "bess",
      "query": "microgrid energy storage reinforcement learning",
      "patterns": [
        "\\bbattery energy storage",
        "\\bBESS\\b",
        "\\benergy storage\\b",
        "\\bbatter(?:y|ies)\\b"
      ]
    },
    {
      "id": "converter-control",
      "query": "grid connected inverter reinforcement learning",
      "patterns": [
        "\\bconverter",
        "\\binverter",
        "\\bSTATCOM\\b"
      ]
    }
  ],
  "journals": [
    "IEEE Transactions on Power Systems",
    "IEEE Transactions on Smart Grid",
    "IEEE Transactions on Power Delivery",
    "IEEE Transactions on Sustainable Energy",
    "IEEE Transactions on Energy Conversion",
    "IEEE Transactions on Power Electronics",
    "IEEE Journal of Emerging and Selected Topics in Power Electronics",
    "International Journal of Electrical Power & Energy Systems",
    "Electric Power Systems Research",
    "Applied Energy",
    "Energy",
    "Renewable Energy",
    "Journal of Energy Storage",
    "IET Generation, Transmission & Distribution",
    "IET Renewable Power Generation",
    "Protection and Control of Modern Power Systems",
    "IEEE Access",
    "IEEE Open Journal of Power Electronics",
    "Sustainable Energy, Grids and Networks"
  ],
  "ai_patterns": [
    "\\bmachine learning\\b",
    "\\bdeep learning\\b",
    "\\breinforcement learning\\b",
    "\\bneural network",
    "\\bartificial intelligence\\b",
    "\\bphysics.informed\\b",
    "\\bdata.driven\\b",
    "\\blearning.based\\b",
    "\\brandom forest",
    "\\bgradient boosting\\b",
    "\\bsupport vector\\b"
